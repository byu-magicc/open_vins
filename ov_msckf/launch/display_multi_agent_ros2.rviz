Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 120
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: Vehicles
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
# BEGIN AGENT TEMPLATE
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.01
          Name: Estimated Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /{namespace}/{agent}/pathimu
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 255; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.01
          Name: Ground Truth Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /{namespace}/{agent}/pathgt
          Unreliable: false
          Value: true
        - Alpha: 0.8
          Class: rviz_default_plugins/PointCloud2
          Color: 252; 175; 62
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: MSCKF Points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 8
          Size (m): 0.01
          Style: Points
          Topic: /{namespace}/{agent}/points_msckf
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 0; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: SLAM Points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 8
          Size (m): 0.01
          Style: Points
          Topic: /{namespace}/{agent}/points_slam
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 117; 80; 123
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ARUCO Points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 15
          Size (m): 0.01
          Style: Points
          Topic: /{namespace}/{agent}/points_aruco
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 127
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Simulation Points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.01
          Style: Points
          Topic: /{namespace}/{agent}/points_sim
          Unreliable: false
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: "{agent}"
# END AGENT TEMPLATE
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: global
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.945398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 100
  Y: 100
